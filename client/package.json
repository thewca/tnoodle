{
    "name": "tnoodle-ui",
    "version": "0.1.0",
    "private": true,
    "homepage": "http://localhost:2014/scramble",
    "dependencies": {
        "@cubing/icons": "^3.0.5",
        "@reduxjs/toolkit": "^2.13.0",
        "axios": "^1.20.0",
        "bootstrap": "^4.6.2",
        "lodash": "^4.18.1",
        "react": "^18.3.1",
        "react-bootstrap": "^2.10.10",
        "react-color": "^2.19.3",
        "react-dom": "^18.3.1",
        "react-icons": "^4.12.0",
        "react-inlinesvg": "^3.0.3",
        "react-redux": "^9.3.0",
        "react-scripts": "5.0.1",
        "web-vitals": "^3.5.2"
    },
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "test": "react-scripts test --watchAll=false --coverage",
        "eject": "react-scripts eject",
        "prettier": "prettier --check .",
        "lint": "prettier --write ."
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/index.tsx",
            "!src/reportWebVitals.ts",
            "!src/react-app-env.d.ts",
            "!src/main/api/**.ts",
            "!src/main/model/**.ts",
            "!**/Interceptor.tsx"
        ],
        "moduleNameMapper": {
            "^axios$": "axios/dist/axios.js"
        }
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^15.0.7",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.25",
        "@types/node": "^24.19.1",
        "@types/react": "^18.3.31",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^18.3.7",
        "prettier": "^3.9.9",
        "typescript": "^4.9.5"
    },
    "packageManager": "yarn@1.22.22"
}
