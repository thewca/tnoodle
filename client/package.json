{
    "name": "tnoodle-ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "homepage": "http://localhost:2014/scramble",
    "dependencies": {
        "@cubing/icons": "^3.0.5",
        "@reduxjs/toolkit": "^2.14.0",
        "axios": "^1.21.1",
        "bootstrap": "^5.3.9",
        "lodash": "^4.18.1",
        "oidc-client-ts": "^3.5.0",
        "react": "^18.3.1",
        "react-bootstrap": "^2.10.10",
        "react-color": "^2.19.3",
        "react-dom": "^18.3.1",
        "react-icons": "^5.7.0",
        "react-inlinesvg": "^4.6.0",
        "react-oidc-context": "^3.3.1",
        "react-redux": "^9.3.1",
        "web-vitals": "^6.2.3"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "test": "vitest run",
        "prettier": "prettier --check .",
        "lint": "prettier --write ."
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/index.tsx",
            "!src/reportWebVitals.ts",
            "!src/react-app-env.d.ts",
            "!src/main/api/**.ts",
            "!src/main/model/**.ts",
            "!**/Interceptor.tsx"
        ],
        "moduleNameMapper": {
            "^axios$": "axios/dist/axios.js"
        }
    },
    "devDependencies": {
        "@redocly/cli": "^2.79.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@types/node": "^24.19.2",
        "@types/react": "^18.3.31",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "jsdom": "^31.0.1",
        "msw": "^3.0.6",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "update-browserslist-db": "^1.3.4",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "packageManager": "yarn@1.22.22"
}
